# scripts/slurm/setup/pins.env — pinned versions/commits for install_env.sh.
#
# AUTO-GENERATED — do not hand-edit, EXCEPT MILES_SGLANG_SOURCE_VERSION and
# MILES_WHEELS_TAG, which only sglang-sync changes. Regenerate the rest with:
#   python scripts/slurm/setup/extract_pins.py --write
#
# Sources of truth:
#   - docker/Dockerfile                          (radixark/miles)
#   - thirdparty/sglang/docker/Dockerfile        (sglang base image)
#   - thirdparty/sglang/python/pyproject.toml    (patched sglang fork)
#
# Each value is overridable: set the env var before invoking install_env.sh
# (e.g. `TE_VERSION=2.11.0 bash scripts/slurm/setup/install_env.sh`).


# From thirdparty/sglang/python/pyproject.toml (patched sglang fork)
# torch the sglang SUBMODULE is built against — this defines ACTIVE torch.
TORCH_VERSION=${TORCH_VERSION:-2.11.0}

# From docker/Dockerfile (radixark/miles)
# Upstream #1796 installs TE from rolling wheels; the version only appears in wheel filenames.
TE_VERSION=${TE_VERSION:-2.17.0}
MBRIDGE_COMMIT=${MBRIDGE_COMMIT:-89eb10887887bc74853f89a4de258c0702932a1c}
# Re-pinned by upstream #1575 after the unpinned #1773/#1774 era.
TMS_COMMIT=${TMS_COMMIT:-74d68c5e4bedf2b6774f2c92ed0f81b7c8d91ed0}
MILES_WHEELS_REPO=${MILES_WHEELS_REPO:-yueming-yuan/miles-wheels}

# From thirdparty/sglang/docker/Dockerfile (sglang base image)
# miles imports mooncake.engine.TransferEngine at top level — required.
MOONCAKE_VERSION=${MOONCAKE_VERSION:-0.3.11.post1}

# --- sglang source + torch-ABI wheels bundle ---
# ACTIVE source tracks thirdparty/sglang independently from the wheels bundle;
# the bundle may lag the source when torch matches. UPSTREAM_* is where
# docker/Dockerfile points. When source and upstream target differ, --check
# prints `[sglang-sync pending]` (exit 0 — deferrable, NOT a sync blocker), and
# install_env.sh hard-fails on any torch-ABI inconsistency.
#
# MILES_SGLANG_SOURCE_VERSION and MILES_WHEELS_TAG are hand-owned by
# sglang-sync. Bundle metadata is DERIVED from WHEELS_STACK — do not hand-edit
# derived fields; run `extract_pins.py --write` after advancing the source and
# selecting a torch-compatible bundle.
MILES_SGLANG_SOURCE_VERSION=${MILES_SGLANG_SOURCE_VERSION:-v0.5.16}
MILES_WHEELS_TAG=${MILES_WHEELS_TAG:-cu129-x86_64}
MILES_WHEELS_TORCH_VERSION=${MILES_WHEELS_TORCH_VERSION:-2.11.0}
MILES_WHEELS_SGLANG_VERSION=${MILES_WHEELS_SGLANG_VERSION:-v0.5.16}
SGLANG_ROUTER_VERSION=${SGLANG_ROUTER_VERSION:-0.3.2}
# UPSTREAM TARGET (from docker/Dockerfile) — advance ACTIVE to this via sglang-sync:
UPSTREAM_SGLANG_IMAGE_TAG=${UPSTREAM_SGLANG_IMAGE_TAG:-v0.5.16}
UPSTREAM_WHEELS_TAG=${UPSTREAM_WHEELS_TAG:-cu130-x86_64}

# Derived from MILES_WHEELS_TAG cu prefix
TORCH_INDEX_URL=${TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu129}
FLASHINFER_INDEX_URL=${FLASHINFER_INDEX_URL:-https://flashinfer.ai/whl/cu129}
SGL_WHL_INDEX_URL=${SGL_WHL_INDEX_URL:-https://docs.sglang.ai/whl/cu129}

# Hand-owned: upstream #1799 moved to FA3 3.0.0 wheels that bundle the python
# interface, so the hopper commit left the Dockerfile. Our ACTIVE wheels bundle
# still ships an interface-less FA3; install_env.sh keeps the guarded fetch and
# this pin until the bundle's FA3 bundles the interface (then delete both).
FLASH_ATTN_INTERFACE_COMMIT=${FLASH_ATTN_INTERFACE_COMMIT:-fbf24f67cf7f6442c5cfb2c1057f4bfc57e72d89}
